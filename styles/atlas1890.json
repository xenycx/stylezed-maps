{
  "name": "Old Atlas",
  "description": "A plate from an 1890s engraved survey atlas: sepia copperplate line work, hachured hills, pen-drawn woods, spaced serif capitals, a title cartouche and a chequered scale border.",
  "name_local": "ძველი ატლასი",
  "description_local": "XIX საუკუნის გრავირებული ატლასის ფურცელი: სეპიის მელანი, დაშტრიხული მთები, ნატიფი შრიფტი და კუბოკრული ჩარჩო.",
  "seed": 1890,
  "wobble_freq": 0.5,
  "palette": {
    "paper": "#ece2c8", "map": "#f2e9d2", "ink": "#33251a", "ink_soft": "#6a523c", "ink_faint": "#9a8163",
    "hachure": "#7a5a3d", "contour": "#a58a66",
    "wash_wood": "#e8e6cb", "wash_water": "#dbe2d6", "wash_water_line": "#cbd9d2", "wash_village": "#f1e6cc", "tree": "#493727",
    "carmine": "#a23a35"
  },
  "fonts": {
    "display": { "en": "Playfair Display", "ka": { "font": "Noto Serif Georgian", "scale": 0.9 } },
    "text": { "en": "EB Garamond", "ka": { "font": "Noto Serif Georgian", "scale": 0.86 } },
    "italic": { "en": { "font": "EB Garamond", "style": "italic", "scale": 1.12 }, "ka": { "font": "Noto Serif Georgian", "style": "italic", "scale": 0.86 } },
    "script": { "en": { "font": "Playfair Display", "style": "italic" }, "ka": { "font": "Noto Serif Georgian", "style": "italic", "scale": 0.88 } }
  },
  "page": {
    "width": 300, "height": 406, "margin": 14, "frame": ["18", "23", "W - 36", "288"],
    "bg": "$paper", "map_bg": "$map",
    "texture": { "tint": "#6b4a25", "grain": 0.045, "mottle": 0.07, "fibers": 0.02, "stains": 2, "vignette": 0.17, "edge_wear": 0.08 }
  },
  "panels": [
    { "x": 12.6, "y": "fb + 21.5", "width": "W - 25.2", "height": 0.18, "fill": "$ink_soft" },
    { "x": 117.5, "y": "fb + 26", "width": 0.18, "height": 52, "fill": "$ink_soft" }
  ],
  "order": ["landcover", "hillshade", "contours", "hachures", "water", "waterways", "ground", "tracks", "paths", "roads", "bridges", "buildings", "trees", "peaks"],
  "relief": {
    "hillshade": { "shadow": "#5b4128", "shadow_opacity": 0.13, "light": "#fffaf0", "light_opacity": 0.0, "exaggeration": 1.4 },
    "contours": { "color": "$contour", "width": 0.06, "index_width": 0.13, "every": 20, "index_every": 100, "opacity": 0.75,
                  "labels": { "font": "@italic", "size": 1.6, "color": "$ink_soft", "halo": "$map", "halo_width": 0.6 } },
    "hachures": { "spacing": 0.9, "min_slope": 0.14, "max_slope": 0.75, "length": [0.5, 1.7], "width": [0.06, 0.2], "color": "$hachure",
                  "opacity": 0.85, "avoid": ["water", "buildings", "roads"] },
    "peaks": { "count": 7, "min_distance": 28, "dot": { "size": 0.4, "color": "$ink" },
               "label": { "font": "@italic", "size": 2.0, "color": "$ink", "halo": "$map", "halo_width": 0.6 } }
  },
  "layers": {
    "landcover": {
      "residential": { "fill": "$wash_village" },
      "religious": { "fill": "$wash_village" },
      "farmland": { "hatch": { "angle": "auto", "gap": 0.75, "color": "$ink_soft", "width": 0.06, "opacity": 0.7, "gap_jitter": 0.05, "inset": 0.35 },
                    "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.9 0.5" } },
      "heath": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "grassland": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "grass": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "meadow": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "scrub": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "scree": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "bare_rock": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.05 0.6" } },
      "orchard": { "fill": "$wash_wood", "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.9 0.5" } },
      "vineyard": { "edge": { "stroke": "$ink_soft", "width": 0.1, "dash": "0.9 0.5" } },
      "wood": { "fill": "$wash_wood", "edge": { "stroke": "$ink_soft", "width": 0.14, "dash": "0.05 0.55" } },
      "cemetery": { "fill": "$map", "edge": { "stroke": "$ink", "width": 0.13, "dash": "0.6 0.35" } }
    },
    "water": { "*": { "fill": "$wash_water", "stroke": "$ink", "width": 0.2,
                      "hatch": { "angle": 0, "gap": 0.62, "gap_jitter": 0, "color": "$ink_soft", "width": 0.05, "opacity": 0.6, "inset": 4.0, "min_area": 60 },
                      "shorelines": { "count": 7, "gap": 0.5, "color": "$ink", "width": 0.1, "opacity": 0.85 } } },
    "waterways": {
      "river": { "stroke": "$ink", "width": 0.5, "casing": { "color": "$wash_water_line", "width": 1.5 }, "wobble": 0.05 },
      "stream": { "stroke": "$ink", "width": 0.26, "casing": { "color": "$wash_water_line", "width": 0.8 }, "wobble": 0.06 },
      "*": { "stroke": "$ink_soft", "width": 0.18, "wobble": 0.03 }
    },
    "tracks": { "*": { "stroke": "$ink", "width": 0.17, "dash": "1.5 0.7", "linecap": "butt" } },
    "paths": { "*": { "stroke": "$carmine", "width": 0.22, "dash": "0.7 0.55", "linecap": "butt" } },
    "roads": {
      "major": { "stroke": "$map", "width": 0.75, "casing": { "color": "$ink", "width": 1.2 } },
      "minor": { "stroke": "$map", "width": 0.36, "casing": { "color": "$ink", "width": 0.68 } }
    },
    "buildings": { "*": { "fill": "$ink", "stroke": "$ink", "width": 0.08 } }
  },
  "bridges": { "size": 1.7, "gap": 0.8, "stroke": "$ink", "width": 0.2, "deck": "$map" },
  "scatter": [
    { "layer": "ground", "on": ["meadow", "grass", "grassland", "heath"], "glyph": "grass", "spacing": 3.0, "jitter": 0.5, "size": [0.7, 1.0],
      "style": { "ink": "$ink_soft", "sw": 0.085 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.5 },
    { "layer": "ground", "on": "open", "glyph": "grass", "spacing": 3.4, "jitter": 0.5, "size": [0.6, 0.9], "slope": [0, 0.2], "clump": 0.38,
      "style": { "ink": "$ink_faint", "sw": 0.11 }, "avoid": ["roads", "buildings", "water", "farmland", "residential", "landmarks", "decor"], "avoid_dist": 0.8 },
    { "layer": "ground", "on": "farmland", "glyph": "haystack", "spacing": 12, "jitter": 0.5, "size": [1.5, 1.9], "inset": 1.4,
      "style": { "ink": "$ink", "fill": "$map", "sw": 0.07 }, "avoid": ["roads", "buildings", "water", "wood", "landmarks", "decor"], "avoid_dist": 1.2 },
    { "layer": "ground", "on": "cemetery", "glyph": "grave", "spacing": 1.5, "jitter": 0.2, "size": [0.9, 1.1], "flip": false,
      "style": { "ink": "$ink", "sw": 0.1 } },
    { "layer": "trees", "on": "water", "glyph": "sailboat", "count": 1, "size": [4.2, 4.6], "inset": 14, "min_area": 3000,
      "style": { "ink": "$ink", "fill": "$map", "sw": 0.045 }, "avoid": ["landmarks", "decor"], "avoid_dist": 6 },
    { "layer": "trees", "on": ["scrub"], "glyph": "bush", "spacing": 2.2, "jitter": 0.45, "size": [1.0, 1.4], "clump": 0.25,
      "style": { "ink": "$ink_soft", "fill": "$map", "sw": 0.08 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.4 },
    { "layer": "trees", "on": ["scree", "bare_rock"], "glyph": "rock", "spacing": 1.7, "jitter": 0.45, "size": [0.8, 1.3],
      "style": { "ink": "$ink_soft", "fill": "$map", "sw": 0.08 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.4 },
    { "layer": "trees", "on": "frame", "glyph": "rock", "spacing": 2.6, "jitter": 0.5, "size": [0.9, 1.5], "slope": [0.7, 9], "clump": 0.4,
      "style": { "ink": "$ink", "fill": "$map", "sw": 0.08 }, "avoid": ["roads", "buildings", "water", "wood", "landmarks", "decor"], "avoid_dist": 0.8 },
    { "layer": "trees", "on": ["vineyard"], "glyph": "vine", "spacing": 1.5, "jitter": 0.05, "size": [0.9, 1.1], "flip": false,
      "style": { "ink": "$tree", "fill": "$tree", "sw": 0.08 }, "avoid": ["roads", "buildings", "landmarks", "decor"] },
    { "layer": "trees", "on": ["orchard"], "glyph": "ink_tree", "spacing": 2.0, "jitter": 0.06, "size": [1.4, 1.6],
      "style": { "ink": "$ink", "fill": "$wash_wood", "sw": 0.07 }, "avoid": ["roads", "buildings", "landmarks", "decor"] },
    { "layer": "trees", "on": "wood", "glyph": ["ink_tree", "conifer"], "weights": [6, 1], "spacing": 2.2, "jitter": 0.42, "size": [1.6, 2.1], "elev": [0, 1380],
      "style": { "ink": "$tree", "fill": "$wash_wood", "sw": 0.065 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.45, "legend": "wood" },
    { "layer": "trees", "on": "wood", "glyph": ["conifer", "ink_tree"], "weights": [4, 1], "spacing": 2.2, "jitter": 0.42, "size": [1.8, 2.3], "elev": [1380, 9000],
      "style": { "ink": "$tree", "fill": "$wash_wood", "sw": 0.065 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.45 },
    { "layer": "trees", "on": "residential", "glyph": "ink_tree", "spacing": 4.6, "jitter": 0.5, "size": [1.5, 2.0], "clump": 0.4,
      "style": { "ink": "$ink_soft", "fill": "$wash_village", "sw": 0.07 }, "avoid": ["roads", "buildings", "water", "landmarks", "decor"], "avoid_dist": 0.9 }
  ],
  "symbols": {
    "spring": { "shape": "circle", "size": 1.5, "color": "$ink", "fill": "$wash_water", "width": 0.22, "legend": "spring", "priority": 2 },
    "drinking_water": { "shape": "circle", "size": 0.85, "color": "$ink", "fill": "$map", "width": 0.16, "legend": "drinking_water", "priority": 8 }
  },
  "landmarks": {
    "sizes": [15, 11, 7.4], "ink": "$ink", "paper": "$map", "tone": "#e0cfa8", "shade": "#8b7052", "accent": "$carmine",
    "stroke": 1.7, "halo": "$map", "halo_width": 5,
    "leader": { "stroke": "$ink", "width": 0.16, "dot": 0.4 },
    "pin": { "r": 1.5, "fill": "$map", "stroke": "$ink", "font": { "font": "@text", "size": 2.0, "color": "$ink", "weight": "bold" } },
    "label": { "font": "@italic", "color": "$ink", "halo": "$map", "halo_width": 0.8 },
    "label_sizes": [3.3, 2.6, 2.2], "label_width": 30,
    "label_hero": { "font": "@script", "color": "$carmine" }
  },
  "custom": {
    "path": { "stroke": "$carmine", "width": 0.55, "dash": "2.6 0.7 0.3 0.7", "linecap": "butt", "casing": { "color": "$map", "width": 1.2, "opacity": 0.85 } },
    "path_label": { "font": "@italic", "size": 2.5, "color": "$carmine", "halo": "$map", "halo_width": 0.8 },
    "place_size": 9,
    "label": { "font": "@italic", "size": 2.5, "color": "$ink", "halo": "$map", "halo_width": 0.8 },
    "note": { "font": "@italic", "size": 2.4, "color": "$carmine", "halo": "$map", "halo_width": 0.8 }
  },
  "labels": {
    "place": { "font": "@display", "size": 5.0, "color": "$ink", "weight": "600", "halo": "$map", "halo_width": 1.5, "upper": true, "ls": 1.3 },
    "place_minor": { "font": "@display", "size": 3.3, "color": "$ink", "halo": "$map", "halo_width": 1.0, "upper": true, "ls": 0.8 },
    "poi": { "font": "@italic", "size": 2.1, "color": "$ink", "halo": "$map", "halo_width": 0.6 },
    "water": { "font": "@script", "size": 2.8, "color": "$ink", "halo": "$map", "halo_width": 0.7, "spread": 4.0 }
  },
  "decorations": {
    "frame": { "style": "triple", "color": "$ink", "width": 0.3, "gap": 1.1, "outer_width": 0.9,
               "checker": { "band": 1.7, "metres": 100, "fill": "$ink", "alt": "none" } },
    "title": { "on_map": true, "style": "plaque", "x": "fx + 74", "y": "fy + 24", "anchor": "middle", "clear": 8,
               "backdrop": { "fill": "$map", "pad": 6.4, "stroke": "$ink", "width": 0.8 },
               "font": { "font": "@display", "size": 9.5, "color": "$ink", "upper": true, "ls": 2.0 },
               "plaque": { "fill": "$map", "ink": "$ink", "width": 0.5, "pad": 4.5 },
               "sub": [
                 { "text": "☙ ❦ ❧", "font": "EB Garamond", "size": 4.6, "color": "$ink" },
                 { "text": { "en": "and its environs", "ka": "და მისი მიდამოები" }, "font": "@script", "size": 3.6, "color": "$carmine" },
                 { "text": "{region}", "font": "@italic", "size": 2.6, "color": "$ink" },
                 { "text": "scale", "font": "@display", "size": 2.2, "color": "$ink", "upper": true, "ls": 0.6 }
               ] },
    "compass": { "on_map": true, "x": "fr - 17", "y": "fb - 16", "size": 9.5, "style": "rose8", "ink": "$ink", "fill": "$map", "accent": "$carmine",
                 "font": { "font": "@display", "size": 3.2, "color": "$ink", "halo": "$map", "halo_width": 0.9 } },
    "scalebar": { "x": "mx", "y": "fb + 13.5", "anchor": "middle", "style": "line", "segments": 5, "h": 1.1, "width": 0.25, "color": "$ink", "fraction": 0.3,
                  "font": { "font": "@italic", "size": 2.3, "color": "$ink" } },
    "legend": { "x": 13, "y": "fb + 36", "columns": 2, "col_width": 51, "gap": 5.0, "swatch": 7.5,
                "font": { "font": "@text", "size": 2.6, "color": "$ink" },
                "title_font": { "font": "@display", "size": 2.9, "color": "$ink", "upper": true, "ls": 0.9 } },
    "index": { "x": 122, "y": "fb + 37.4", "columns": 3, "col_width": 55, "row": 7.7, "icon": 7,
               "font": { "font": "@text", "size": 2.6, "color": "$ink" },
               "title_font": { "font": "@display", "size": 2.9, "color": "$ink", "upper": true, "ls": 0.9 } },
    "texts": [
      { "x": 12.6, "y": 12.5, "anchor": "start", "font": "@display", "size": 2.4, "color": "$ink_soft", "upper": true, "ls": 0.9, "lines": ["{country}"] },
      { "x": "mx", "y": 12.5, "anchor": "middle", "font": "@display", "size": 2.6, "color": "$ink", "upper": true, "ls": 1.4,
        "lines": [{ "en": "Topographical Survey", "ka": "ტოპოგრაფიული აგეგმვა" }] },
      { "x": "W - 12.6", "y": 12.5, "anchor": "end", "font": "@italic", "size": 2.5, "color": "$ink_soft", "lines": ["{lat}° · {lon}°"] },
      { "x": 12.6, "y": "fb + 13.5", "anchor": "start", "font": "@italic", "size": 2.4, "color": "$ink_soft", "lines": ["elevation"] },
      { "x": "W - 12.6", "y": "fb + 13.5", "anchor": "end", "font": "@italic", "size": 2.4, "color": "$ink_soft",
        "lines": [{ "en": "Contours at every {interval} metres", "ka": "ჰორიზონტალები ყოველ {interval} მეტრზე" }] }
    ],
    "attribution": { "x": "cx", "y": "H - 5.5", "anchor": "middle", "font": "@text", "size": 1.9, "color": "$ink_soft" }
  }
}
