{
  "name": "Hiking",
  "description": "Practical walking map: 10 m contours, shaded relief, UTM 1 km grid, marked trails, springs, spot heights — with drawn landmark icons.",
  "name_local": "სალაშქრო",
  "description_local": "პრაქტიკული სალაშქრო რუკა: ჰორიზონტალები, რელიეფის ჩრდილი, UTM ბადე, ბილიკები, წყაროები და სიმაღლის ნიშნულები.",
  "seed": 5,
  "palette": {
    "paper": "#fbfaf5", "map": "#f6f4ea", "ink": "#1f2320", "ink_soft": "#55605a", "green": "#24452f", "green_soft": "#cfe0c8",
    "red": "#d7261e", "blue": "#2a6db0", "water": "#a9cde8", "water_line": "#3f8ccc", "contour": "#a9743f",
    "forest": "#c7ddb0", "forest_tree": "#9dbf88", "forest_dark": "#6f9a62", "field": "#f1ead0", "meadow": "#e7edcb", "village": "#ece4da",
    "building": "#6e6259", "track": "#6b4a2b", "road": "#f08a3c", "road_edge": "#7a3b12"
  },
  "fonts": {
    "display": { "en": "FiraGO", "ka": "Noto Sans Georgian" },
    "text": { "en": "FiraGO", "ka": "FiraGO" },
    "italic": { "en": { "font": "FiraGO", "style": "italic" }, "ka": { "font": "FiraGO", "style": "italic" } }
  },
  "page": { "width": 297, "height": 420, "margin": 12, "frame": ["m", "48", "W - 2*m", "296"], "bg": "$paper", "map_bg": "$map",
            "texture": { "tint": "#6a6048", "grain": 0.03, "mottle": 0.025, "fibers": 0.0, "vignette": 0.0 } },
  "panels": [
    { "x": 0, "y": 0, "width": "W", "height": 38, "fill": "$green" },
    { "x": 0, "y": 38, "width": "W", "height": 1.2, "fill": "$red" }
  ],
  "order": ["landcover", "hillshade", "contours", "water", "waterways", "ground", "grid", "tracks", "paths", "roads", "bridges", "buildings", "trees", "peaks"],
  "relief": {
    "hillshade": { "shadow": "#34404f", "shadow_opacity": 0.42, "light": "#fffbea", "light_opacity": 0.22 },
    "contours": { "color": "$contour", "width": 0.09, "index_width": 0.24, "opacity": 0.85, "every": 10, "index_every": 50,
                  "labels": { "font": "@text", "size": 1.6, "halo": "$map", "halo_width": 0.6 } },
    "peaks": { "count": 6, "min_distance": 26, "dot": { "size": 0.45, "color": "#5a3d22" },
               "label": { "font": "@italic", "size": 1.9, "color": "#5a3d22", "halo": "$map", "halo_width": 0.6 } }
  },
  "grid": { "step": 1000, "color": "$blue", "width": 0.12, "opacity": 0.55, "edge_labels": { "font": "@text", "size": 1.9, "color": "$blue" } },
  "layers": {
    "landcover": {
      "residential": { "fill": "$village" }, "religious": { "fill": "$village" },
      "farmland": { "fill": "$field" }, "meadow": { "fill": "$meadow" }, "grass": { "fill": "$meadow" }, "grassland": { "fill": "$meadow" },
      "heath": { "fill": "$meadow" }, "scrub": { "fill": "#d6e3b9" }, "orchard": { "fill": "#d9e6bd" }, "vineyard": { "fill": "#e2d9b6" },
      "wood": { "fill": "$forest" }, "cemetery": { "fill": "#d2dcc9" }
    },
    "water": { "*": { "fill": "$water", "stroke": "$water_line", "width": 0.18,
                      "shorelines": { "count": 2, "gap": 0.6, "color": "$water_line", "width": 0.1, "opacity": 0.5 } } },
    "waterways": { "river": { "stroke": "$water", "width": 0.9, "casing": { "color": "$water_line", "width": 1.25 } },
                   "stream": { "stroke": "$water_line", "width": 0.32 }, "*": { "stroke": "$water_line", "width": 0.28 } },
    "tracks": { "*": { "stroke": "$track", "width": 0.38, "dash": "1.4 0.6", "linecap": "butt" } },
    "paths": { "*": { "stroke": "$red", "width": 0.45, "dash": "1.1 0.55", "linecap": "butt", "casing": { "color": "#ffffff", "width": 0.95 } } },
    "roads": { "major": { "stroke": "$road", "width": 1.05, "casing": { "color": "$road_edge", "width": 1.45 } },
               "minor": { "stroke": "#ffffff", "width": 0.6, "casing": { "color": "#857d72", "width": 0.9 } } },
    "buildings": { "*": { "fill": "$building" } }
  },
  "bridges": { "size": 1.6, "gap": 0.8, "stroke": "$ink", "width": 0.22 },
  "scatter": [
    { "layer": "trees", "on": "wood", "glyph": ["round", "conifer"], "weights": [3, 1], "spacing": 3.6, "jitter": 0.45, "size": [1.5, 1.9], "elev": [0, 1380],
      "style": { "fill": "$forest_tree", "shade": "$forest_dark", "trunk": "$forest_dark", "shade_opacity": 0.5 }, "avoid": ["roads", "paths", "buildings", "water", "landmarks"], "avoid_dist": 0.6, "opacity": 0.9 },
    { "layer": "trees", "on": "wood", "glyph": ["conifer", "round"], "weights": [4, 1], "spacing": 3.6, "jitter": 0.45, "size": [1.6, 2.0], "elev": [1380, 9000],
      "style": { "fill": "$forest_tree", "shade": "$forest_dark", "trunk": "$forest_dark", "shade_opacity": 0.5 }, "avoid": ["roads", "paths", "buildings", "water", "landmarks"], "avoid_dist": 0.6, "opacity": 0.9 },
    { "layer": "ground", "on": "frame", "glyph": "rock", "spacing": 2.8, "jitter": 0.5, "size": [0.9, 1.4], "slope": [0.65, 9], "clump": 0.4,
      "style": { "ink": "$ink_soft", "fill": "#e6e1d6", "shade": "#9a948a", "sw": 0.08 }, "avoid": ["roads", "buildings", "water", "landmarks"], "avoid_dist": 0.8 },
    { "layer": "ground", "on": "cemetery", "glyph": "grave", "spacing": 1.8, "jitter": 0.2, "size": [0.9, 1.1], "flip": false, "style": { "ink": "$ink_soft", "sw": 0.11 } }
  ],
  "symbols": {
    "spring": { "shape": "drop", "size": 2.2, "color": "#1f5f9e", "fill": "$water", "width": 0.25, "legend": "spring", "priority": 2 },
    "drinking_water": { "shape": "circle", "size": 1.0, "color": "#1f5f9e", "fill": "#ffffff", "width": 0.25, "legend": "drinking_water", "priority": 8 }
  },
  "landmarks": {
    "sizes": [13, 10, 7], "ink": "$ink", "paper": "#ffffff", "tone": "#e3d6bf", "shade": "#7d7468", "accent": "$red", "stroke": 2.3,
    "halo": "#ffffff", "halo_width": 7,
    "leader": { "stroke": "$ink", "width": 0.2, "dot": 0.5 },
    "pin": { "r": 1.5, "fill": "$red", "stroke": "#ffffff", "font": { "font": "@text", "size": 2, "color": "#ffffff", "weight": "bold" } },
    "label": { "font": "@text", "color": "$ink", "weight": "bold", "halo": "#ffffff", "halo_width": 0.8 },
    "label_sizes": [2.7, 2.3, 1.9], "label_width": 28
  },
  "custom": {
    "path": { "stroke": "#8e24aa", "width": 0.8, "casing": { "color": "#ffffff", "width": 1.5, "opacity": 0.9 }, "dash": "2.2 0.9", "linecap": "butt" },
    "path_label": { "font": "@text", "size": 2.3, "color": "#8e24aa", "weight": "bold", "halo": "#ffffff", "halo_width": 0.8 },
    "place_size": 8,
    "label": { "font": "@text", "size": 2.2, "color": "$ink", "weight": "bold", "halo": "#ffffff", "halo_width": 0.8 },
    "note": { "font": "@italic", "size": 2.2, "color": "#8e24aa", "halo": "#ffffff", "halo_width": 0.8 }
  },
  "labels": {
    "place": { "font": "@display", "size": 5.0, "color": "$ink", "weight": "bold", "halo": "#ffffff", "halo_width": 1.1, "upper": true, "ls": 0.3 },
    "place_minor": { "font": "@display", "size": 3.5, "color": "$ink", "weight": "bold", "halo": "#ffffff", "halo_width": 0.9, "upper": true, "ls": 0.25 },
    "poi": { "font": "@text", "size": 2.0, "color": "$ink", "halo": "#ffffff", "halo_width": 0.6 },
    "water": { "font": "@italic", "size": 2.6, "color": "#1f5f9e", "halo": "$map", "halo_width": 0.6, "spread": 3.6 }
  },
  "decorations": {
    "frame": { "color": "$ink", "width": 0.45 },
    "title": { "x": "m", "y": 17, "anchor": "start", "font": { "font": "@display", "size": 13, "color": "#ffffff", "weight": "bold", "ls": 1.0, "upper": true },
               "sub": [ { "text": "{region}", "font": "@text", "size": 4.2, "color": "$green_soft" } ] },
    "texts": [
      { "x": "W - m", "y": 15, "anchor": "end", "font": "@display", "size": 3.6, "color": "#ffffff", "weight": "bold", "ls": 0.5, "upper": true, "lines": ["hiking_map"] },
      { "x": "W - m", "y": 22, "anchor": "end", "font": "@text", "size": 3.0, "color": "$green_soft", "lines": ["scale"] },
      { "x": "m", "y": "H - 13", "font": "@text", "size": 2.1, "color": "$ink_soft", "gap": 3.2, "lines": ["elevation", "grid_note"] }
    ],
    "legend": { "x": "m", "y": "fb + 17", "columns": 2, "col_width": 47, "gap": 4.7, "swatch": 8,
                "font": { "font": "@text", "size": 2.2, "color": "$ink" },
                "title_font": { "font": "@display", "size": 2.6, "color": "$green", "weight": "bold", "ls": 0.4, "upper": true } },
    "index": { "x": "m + 102", "y": "fb + 17", "columns": 3, "col_width": 57, "row": 7.6, "icon": 6.6,
               "font": { "font": "@text", "size": 2.2, "color": "$ink" },
               "title_font": { "font": "@display", "size": 2.6, "color": "$green", "weight": "bold", "ls": 0.4, "upper": true } },
    "scalebar": { "x": "W - m - 84", "y": "H - 16", "segments": 4, "h": 1.4, "color": "$ink", "alt": "#ffffff", "fraction": 0.24,
                  "font": { "font": "@text", "size": 2.2, "color": "$ink" } },
    "compass": { "x": "W - m - 6", "y": "H - 15", "size": 6, "style": "arrow", "ink": "$ink", "fill": "$paper",
                 "font": { "font": "@display", "size": 3, "color": "$ink", "weight": "bold" } },
    "attribution": { "x": "m", "y": "H - 5", "anchor": "start", "font": "@text", "size": 1.8, "color": "#8a8a84" }
  }
}
